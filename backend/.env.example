# Backend database connection
SPRING_DATASOURCE_URL=jdbc:mysql://<host>:<port>/<database>?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=<db-username>
SPRING_DATASOURCE_PASSWORD=<db-password>

# JWT secret
APP_JWT_SECRET=your-jwt-secret

# File upload storage path
APP_UPLOAD_DIR=./uploads

# CORS allowed origins for deployed frontend
APP_CORS_ALLOWED_ORIGINS=https://your-frontend-url
